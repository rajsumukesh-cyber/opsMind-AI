# OpsMind AI - Environment Variables
# Groq AI Inference (Recommended models: llama-3.3-70b-versatile, qwen/qwen3-32b, openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Persistent Memory Configuration
# If self-hosting or using Hindsight Cloud, set URL & Key:
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Application Server
PORT=8000
JWT_SECRET_KEY=opsmind-super-secret-jwt-key-2026
OPSMIND_DB_PATH=backend/opsmind.db
